          <div class="code-header"><div class="code-dots"><span></span><span></span><span></span></div><span class="code-filename">index.php</span></div>
<pre class="code"><span class="line"><span class="tag">&lt;?php</span></span>
<span class="line"><span class="var">$host</span>     <span class="op">=</span> <span class="str">"localhost"</span>;</span>
<span class="line"><span class="var">$username</span> <span class="op">=</span> <span class="str">"root"</span>;</span>
<span class="line"><span class="var">$password</span> <span class="op">=</span> <span class="str">""</span>;</span>
