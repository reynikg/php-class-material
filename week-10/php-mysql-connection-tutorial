<span class="line"><span class="var">$host</span> <span class="op">=</span> <span class="str">"localhost"</span>; <span class="var">$username</span> <span class="op">=</span> <span class="str">"root"</span>;</span>
<span class="line"><span class="var">$password</span> <span class="op">=</span> <span class="str">""</span>; <span class="var">$database</span> <span class="op">=</span> <span class="str">"my_shop"</span>;</span>
<span class="line"> </span>
<span class="line"><span class="var">$conn</span> <span class="op">=</span> <span class="fn">mysqli_connect</span>(<span class="var">$host</span>, <span class="var">$username</span>, <span class="var">$password</span>, <span class="var">$database</span>);</span>
<span class="line"><span class="kw">if</span> (!<span class="var">$conn</span>) { <span class="fn">die</span>(<span class="str">"Αποτυχία σύνδεσης: "</span> . <span class="fn">mysqli_connect_error</span>()); }</span>
<span class="line"><span class="tag">?&gt;</span></span></pre>
        </div>
        <div class="code-block">
          <div class="code-header"><div class="code-dots"><span></span><span></span><span></span></div><span class="code-filename">index.php</span></div>
<pre class="code"><span class="line"><span class="tag">&lt;?php</span></span>
<span class="line new"><span class="kw">require_once</span> <span class="str">'db_connect.php'</span>;</span>
<span class="line"> </span>
<span class="line"><span class="cmt">// Από εδώ και πέρα η $conn είναι έτοιμη!</span></span>
<span class="line"><span class="tag">?&gt;</span></span></pre>
        </div>
      </div>
