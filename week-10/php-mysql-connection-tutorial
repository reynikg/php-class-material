            <text class="hub-arrow-label" x="270" y="192">require_once</text>
            <text class="hub-arrow-label" x="392" y="176">require_once</text>
            <g><rect class="hub-leaf-bg" x="50" y="30" width="100" height="34" rx="7"/><text class="hub-leaf-text" x="100" y="50">index.php</text></g>
            <g><rect class="hub-leaf-bg" x="410" y="30" width="100" height="34" rx="7"/><text class="hub-leaf-text" x="460" y="50">products.php</text></g>
            <g><rect class="hub-leaf-bg" x="10" y="180" width="100" height="34" rx="7"/><text class="hub-leaf-text" x="60" y="200">contact.php</text></g>
            <g><rect class="hub-leaf-bg" x="210" y="210" width="100" height="34" rx="7"/><text class="hub-leaf-text" x="260" y="230">cart.php</text></g>
