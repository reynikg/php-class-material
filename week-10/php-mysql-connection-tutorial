<!DOCTYPE html>
<html lang="el">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PHP &amp; MySQL — Από την Εγκατάσταση στα Δεδομένα</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  /* ============ DESIGN TOKENS (Apple-inspired) ============ */
  :root {
    --bg: #fbfbfd;
    --surface: #ffffff;
    --surface-2: #f5f5f7;
    --surface-3: #ececef;
    --border: #d2d2d7;
    --border-light: #e8e8ed;
    --text: #1d1d1f;
    --text-2: #6e6e73;
    --text-3: #86868b;
    --accent: #0071e3;
    --accent-hover: #0077ed;
    --accent-soft: #e8f1fc;
    --success: #34c759;
    --success-soft: #e8f8ee;
    --success-deep: #006e2e;
    --error: #ff3b30;
    --error-soft: #fdebea;
    --warning: #ff9500;
    --warning-soft: #fff4e5;
    --purple: #af52de;
    --db: #00758f;
    --db-soft: #d4e8ee;
    --db-deep: #005266;
    --code-bg: #1d1d1f;
    --code-text: #f5f5f7;
    --kw: #ff7ab2;
    --str: #ff8170;
    --num: #d9c97e;
    --fn: #67b7e0;
    --cmt: #7c7c80;
    --var: #a3c2ff;
    --tag-c: #a8c8ff;

    --radius-sm: 8px;
    --radius: 14px;
    --radius-lg: 20px;
    --radius-xl: 28px;

    --shadow-sm: 0 1px 2px rgba(0,0,0,0.04);
    --shadow: 0 4px 16px rgba(0,0,0,0.06);
    --shadow-lg: 0 12px 40px rgba(0,0,0,0.10);

    --ease: cubic-bezier(0.32, 0.72, 0, 1);
    --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }
  html, body { height: 100%; }
  body {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  code, pre, .mono { font-family: 'JetBrains Mono', 'SF Mono', Menlo, monospace; }

  /* ============ TOP BAR ============ */
  .topbar {
    position: sticky; top: 0; z-index: 100;
    background: rgba(251,251,253,0.85);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--border-light);
  }
  .topbar-inner {
    max-width: 1180px; margin: 0 auto;
    padding: 14px 32px; display: flex; align-items: center; gap: 20px;
  }
  .logo {
    font-weight: 800; font-size: 17px; letter-spacing: -0.01em;
    display: flex; align-items: center; gap: 10px; white-space: nowrap;
  }
  .logo-dot {
    width: 22px; height: 22px; border-radius: 7px;
    background: linear-gradient(135deg, #0071e3, #af52de);
    display: grid; place-items: center; color: white;
    font-size: 13px; font-weight: 800;
  }
  .chapter-tag {
    font-size: 12px; color: var(--text-2); font-weight: 500;
    padding: 4px 10px; background: var(--surface-2);
    border-radius: 100px; white-space: nowrap;
  }
  .progress-wrap { flex: 1; display: flex; align-items: center; gap: 12px; }
  .progress-track {
    flex: 1; height: 4px; background: var(--surface-3);
    border-radius: 100px; overflow: hidden; max-width: 340px; margin-left: auto;
  }
  .progress-fill {
    height: 100%; background: linear-gradient(90deg, #0071e3, #af52de);
    width: 0%; transition: width 0.6s var(--ease); border-radius: 100px;
  }
  .progress-text { font-size: 12px; color: var(--text-2); font-variant-numeric: tabular-nums; min-width: 42px; text-align: right; }

  /* ============ MAIN ============ */
  main {
    max-width: 1180px; margin: 0 auto;
    padding: 44px 32px 150px;
    min-height: calc(100vh - 60px);
  }
  .step { display: none; animation: stepIn 0.55s var(--ease); }
  .step.active { display: block; }
  @keyframes stepIn {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Two-column stage layout */
  .stage-grid {
    display: grid; grid-template-columns: 1fr 1.05fr; gap: 48px; align-items: start;
  }
  @media (max-width: 940px) { .stage-grid { grid-template-columns: 1fr; gap: 32px; } }

  .step-label {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 13px; font-weight: 600; color: var(--accent);
    margin-bottom: 14px; letter-spacing: 0.01em;
  }
  .step-label-dot {
    width: 6px; height: 6px; border-radius: 50%; background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .step-num-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; font-weight: 600; letter-spacing: 0.06em;
    background: var(--accent); color: white;
    padding: 2px 8px; border-radius: 6px;
  }

  h1 {
    font-size: 52px; font-weight: 800; letter-spacing: -0.025em;
    line-height: 1.05; margin-bottom: 18px; color: var(--text);
  }
  h2 {
    font-size: 34px; font-weight: 700; letter-spacing: -0.02em;
    line-height: 1.12; margin-bottom: 16px;
  }
  h2 em { font-style: normal; color: var(--accent); }
  .lead { font-size: 19px; color: var(--text-2); max-width: 720px; margin-bottom: 28px; }
  .stage-text p { font-size: 16px; color: var(--text); margin-bottom: 14px; }
  .stage-text p.muted { color: var(--text-2); }
  strong { font-weight: 600; }
  .stage-text code, .inline-code {
    font-family: 'JetBrains Mono', monospace; font-size: 0.86em;
    background: var(--accent-soft); color: var(--accent);
    padding: 1px 7px; border-radius: 6px; font-weight: 500;
  }

  /* Callouts */
  .callout {
    display: flex; gap: 14px;
    background: var(--accent-soft);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 16px 20px; margin-top: 20px;
  }
  .callout-icon {
    flex-shrink: 0; width: 24px; height: 24px;
    background: var(--accent); color: white; border-radius: 50%;
    display: grid; place-items: center; font-weight: 700; font-size: 13px;
  }
  .callout p { margin: 0; font-size: 15px; }
  .callout strong { color: var(--accent); }
  .callout.warn { background: var(--warning-soft); border-left-color: var(--warning); }
  .callout.warn .callout-icon { background: var(--warning); }
  .callout.warn strong { color: #a25700; }

  /* ============ VISUAL PANEL ============ */
  .visual-panel {
    background: var(--surface);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    padding: 24px;
    box-shadow: var(--shadow);
    position: relative;
  }
  .visual-label {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--text-3); font-weight: 600; margin-bottom: 16px;
    display: block;
  }

  /* ============ CODE BLOCK ============ */
  .code-block {
    background: var(--code-bg); color: var(--code-text);
    border-radius: var(--radius); overflow: hidden;
    margin-top: 18px; box-shadow: var(--shadow);
  }
  .code-block.first { margin-top: 0; }
  .code-header {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 18px; border-bottom: 1px solid rgba(255,255,255,0.08);
    font-size: 12px; color: rgba(245,245,247,0.6); font-weight: 500;
  }
  .code-dots { display: flex; gap: 6px; }
  .code-dots span { width: 11px; height: 11px; border-radius: 50%; }
  .code-dots span:nth-child(1) { background: #ff5f57; }
  .code-dots span:nth-child(2) { background: #febc2e; }
  .code-dots span:nth-child(3) { background: #28c840; }
  .code-filename { margin-left: 4px; font-family: 'JetBrains Mono', monospace; }
  pre.code {
    padding: 18px 20px; font-size: 13px; line-height: 1.7;
    overflow-x: auto; font-family: 'JetBrains Mono', monospace;
  }
  pre.code .line { display: block; }
  pre.code .kw { color: var(--kw); }
  pre.code .str { color: var(--str); }
  pre.code .num { color: var(--num); }
  pre.code .fn { color: var(--fn); }
  pre.code .cmt { color: var(--cmt); font-style: italic; }
  pre.code .var { color: var(--var); }
  pre.code .tag { color: var(--tag-c); }
  pre.code .op { color: #ddd3c2; }
  pre.code .line.new {
    background: rgba(255,122,178,0.10);
    border-left: 2px solid var(--kw);
    padding-left: 8px; margin-left: -10px;
    animation: lineIn 0.55s 0.15s both var(--ease);
  }
  @keyframes lineIn {
    from { opacity: 0; transform: translateX(-8px); background: rgba(255,122,178,0.22); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* ============ HERO / COVER ============ */
  .hero { text-align: center; padding: 30px 0 20px; }
  .hero-icon-row { display: flex; justify-content: center; gap: 12px; margin-bottom: 28px; }
  .hero-icon-row .icon-tile {
    width: 56px; height: 56px; border-radius: 16px;
    display: grid; place-items: center; color: white; font-weight: 800;
    font-family: 'JetBrains Mono', monospace; font-size: 14px; box-shadow: var(--shadow);
  }
  .icon-tile.php { background: linear-gradient(135deg, #777bb4, #4f5b93); }
  .icon-tile.sql { background: linear-gradient(135deg, #00758f, #f29111); }
  .icon-tile.html { background: linear-gradient(135deg, #e34c26, #f06529); }
  .hero .lead { margin-left: auto; margin-right: auto; }
  .hero-toc {
    max-width: 820px; margin: 36px auto 0;
    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 10px;
    text-align: left;
  }
  .hero-toc-item {
    display: flex; align-items: center; gap: 12px;
    padding: 14px 16px; background: var(--surface);
    border: 1px solid var(--border-light); border-radius: var(--radius);
    cursor: pointer; transition: all 0.2s var(--ease); box-shadow: var(--shadow-sm);
  }
  .hero-toc-item:hover { transform: translateY(-2px); box-shadow: var(--shadow); border-color: var(--accent-soft); }
  .hero-toc-num {
    font-family: 'JetBrains Mono', monospace; font-size: 13px; font-weight: 700;
    color: var(--accent); min-width: 24px;
  }
  .hero-toc-title { font-size: 14px; font-weight: 500; }
  .hero-cta { margin-top: 36px; }
  .kb-hint { font-size: 13px; color: var(--text-3); margin-top: 16px; }
  .kb-hint kbd {
    font-family: 'JetBrains Mono', monospace; font-size: 12px;
    background: var(--surface-2); border: 1px solid var(--border);
    padding: 2px 7px; border-radius: 6px; margin: 0 2px;
  }

  /* ============ STEP 1: XAMPP PANEL ============ */
  .xampp {
    background: #f0f0f2; border: 1px solid var(--border);
    border-radius: var(--radius); overflow: hidden;
    font-size: 13px; box-shadow: var(--shadow-sm);
  }
  .xampp-titlebar {
    background: linear-gradient(135deg, #5a8fd0, #3a6fb0); color: white;
    padding: 8px 14px; display: flex; align-items: center; gap: 8px;
    font-size: 13px; font-weight: 600;
  }
  .xampp-titlebar .tdot { width: 11px; height: 11px; border-radius: 50%; background: #ffb347; }
  .xampp-header {
    background: var(--surface-2); padding: 8px 14px;
    border-bottom: 1px solid var(--border-light);
    font-weight: 600; font-size: 12px; color: var(--text-2);
  }
  .xampp-grid, .xampp-row {
    display: grid; grid-template-columns: 30px 1fr 56px 70px 70px 80px;
    align-items: center;
  }
  .xampp-grid {
    background: var(--surface); font-size: 11px; font-weight: 700;
    color: var(--text-2); border-bottom: 1px solid var(--border-light);
    text-transform: uppercase; letter-spacing: 0.04em;
  }
  .xampp-grid > div { padding: 7px 8px; }
  .xampp-row {
    background: var(--surface); font-size: 13px;
    border-bottom: 1px solid var(--border-light); transition: background 0.4s var(--ease);
  }
  .xampp-row > div { padding: 9px 8px; }
  .xampp-row.running { background: var(--success-soft); }
  .xampp-check {
    width: 14px; height: 14px; border: 1.5px solid var(--text-3);
    background: var(--surface); border-radius: 4px; position: relative;
  }
  .xampp-row.running .xampp-check {
    background: var(--success); border-color: var(--success-deep);
  }
  .xampp-row.running .xampp-check::after {
    content: '✓'; color: white; position: absolute; inset: 0;
    display: grid; place-items: center; font-size: 10px; font-weight: 700;
  }
  .xampp-module { font-weight: 600; color: var(--text); }
  .xampp-row.running .xampp-module { color: var(--success-deep); }
  .xampp-pid, .xampp-port {
    font-family: 'JetBrains Mono', monospace; font-size: 11px;
    color: var(--text-3); text-align: right;
  }
  .xampp-row.running .xampp-pid, .xampp-row.running .xampp-port { color: var(--success-deep); font-weight: 500; }
  .xampp-btn {
    background: var(--surface-2); border: 1px solid var(--border);
    font-size: 11px; padding: 5px 10px; border-radius: 6px; font-weight: 600;
    color: var(--text); cursor: pointer; transition: all 0.3s var(--ease);
    width: 100%;
  }
  .xampp-row.running .xampp-btn {
    background: var(--success); color: white; border-color: var(--success-deep);
  }
  .xampp-actions {
    padding: 11px 14px; background: var(--surface-2); font-size: 12px;
    color: var(--text-2); display: flex; gap: 8px; align-items: center;
  }
  .xampp-actions .pulse {
    width: 8px; height: 8px; border-radius: 50%; background: var(--success);
    animation: pulse 1.5s infinite;
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(52,199,89,0.6); }
    50% { box-shadow: 0 0 0 6px rgba(52,199,89,0); }
  }

  /* ============ STEP 2: BROWSER MOCKUP ============ */
  .browser {
    background: var(--surface-2); border-radius: var(--radius);
    border: 1px solid var(--border); overflow: hidden; box-shadow: var(--shadow-sm);
  }
  .browser-bar {
    background: var(--surface-3); padding: 11px 14px;
    display: flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--border-light);
  }
  .browser-dots { display: flex; gap: 6px; }
  .browser-dots span { width: 11px; height: 11px; border-radius: 50%; background: #ff5f57; }
  .browser-dots span:nth-child(2) { background: #febc2e; }
  .browser-dots span:nth-child(3) { background: #28c840; }
  .browser-nav { display: flex; gap: 8px; color: var(--text-3); font-size: 15px; margin: 0 6px; }
  .browser-url {
    flex: 1; background: var(--surface); border: 1px solid var(--border);
    border-radius: 8px; padding: 6px 12px; font-family: 'JetBrains Mono', monospace;
    font-size: 13px; color: var(--text); display: flex; align-items: center; gap: 8px; min-height: 30px;
  }
  .browser-url::before { content: '🔒'; font-size: 11px; opacity: 0.5; }
  .browser-url .url-typed { display: inline-block; }
  .step.active .browser-url .url-typed {
    animation: typing 1.8s steps(28, end) 0.3s both; overflow: hidden; white-space: nowrap;
  }
  .browser-url .url-typed::after {
    content: ''; display: inline-block; width: 2px; height: 13px;
    background: var(--text); margin-left: 2px; vertical-align: middle; animation: blink 1s infinite;
  }
  @keyframes typing { from { width: 0; } to { width: 100%; } }
  @keyframes blink { 50% { opacity: 0; } }
  .browser-body { background: var(--surface); padding: 24px; min-height: 240px; }
  .pma-logo { font-weight: 800; font-size: 22px; color: #ff6c2c; margin-bottom: 16px; letter-spacing: -0.01em; }
  .pma-logo span { color: #4a90c9; }
  .pma-welcome {
    background: var(--accent-soft); border: 1px solid var(--db-soft);
    border-radius: var(--radius-sm); padding: 14px 18px; font-size: 14px; color: var(--text);
  }
  .pma-welcome strong { color: var(--accent); }
  .pma-welcome .check {
    display: inline-block; width: 18px; height: 18px; background: var(--success);
    color: white; border-radius: 50%; text-align: center; font-size: 11px;
    font-weight: 700; line-height: 18px; margin-right: 6px; vertical-align: middle;
  }
  .pma-welcome .sub { font-size: 12px; color: var(--text-2); }

  /* ============ STEP 3: PHPMYADMIN CREATE DB ============ */
  .pma {
    display: grid; grid-template-columns: 130px 1fr; background: var(--surface);
    border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden;
    font-size: 13px; box-shadow: var(--shadow-sm);
  }
  .pma-side { background: var(--surface-2); padding: 12px 10px; border-right: 1px solid var(--border-light); }
  .pma-side-title {
    font-weight: 700; color: #ff6c2c; font-size: 12px; margin-bottom: 8px;
    padding-bottom: 6px; border-bottom: 1px solid var(--border-light);
  }
  .pma-new {
    display: flex; align-items: center; gap: 6px; padding: 6px 8px;
    background: var(--surface); border: 1px solid var(--accent); border-radius: 6px;
    margin-bottom: 8px; font-weight: 600; color: var(--accent); cursor: pointer; font-size: 12px;
    animation: hl 2s ease-in-out 0.4s 2;
  }
  .pma-new::before { content: '+'; font-size: 15px; font-weight: 800; }
  @keyframes hl {
    0%, 100% { box-shadow: 0 0 0 0 rgba(0,113,227,0); }
    50% { box-shadow: 0 0 0 4px rgba(0,113,227,0.18); }
  }
  .pma-side-list { list-style: none; font-size: 12px; color: var(--text-2); }
  .pma-side-list li { padding: 4px 8px; margin-bottom: 1px; }
  .pma-side-list li.new-db {
    background: var(--success-soft); color: var(--success-deep); font-weight: 600;
    border-radius: 6px; opacity: 0; animation: fadeInDB 0.6s 2s both;
  }
  @keyframes fadeInDB { from { opacity: 0; transform: translateX(-8px); } to { opacity: 1; transform: translateX(0); } }
  .pma-main { padding: 16px 18px; }
  .pma-tab { font-size: 11px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-3); margin-bottom: 6px; }
  .pma-h { font-size: 17px; font-weight: 700; color: var(--text); margin-bottom: 14px; }
  .pma-form-row {
    display: grid; grid-template-columns: 1fr 1fr auto; gap: 8px; align-items: center;
    padding: 12px; background: var(--surface-2); border: 1px solid var(--border-light); border-radius: var(--radius-sm);
  }
  .pma-input, .pma-select {
    background: var(--surface); border: 1px solid var(--border); padding: 7px 10px;
    font-family: 'JetBrains Mono', monospace; font-size: 12px; border-radius: 6px; color: var(--text);
  }
  .pma-input.filled { border-color: var(--accent); box-shadow: inset 0 0 0 1px rgba(0,113,227,0.2); animation: fillIn 0.5s 0.8s both; }
  .pma-select.filled { border-color: var(--accent); animation: fillIn 0.5s 1.4s both; }
  @keyframes fillIn { from { background: var(--accent-soft); } to { background: var(--surface); } }
  .pma-btn {
    background: var(--surface-2); border: 1px solid var(--border); padding: 7px 16px;
    font-size: 13px; border-radius: 6px; font-weight: 600; color: var(--text); cursor: pointer; transition: all 0.3s var(--ease);
  }
  .pma-btn.success {
    background: var(--success); color: white; border-color: var(--success-deep); animation: btnPress 0.4s 1.8s both;
  }
  @keyframes btnPress { 0% { transform: scale(1); } 40% { transform: scale(0.92); } 100% { transform: scale(1); } }
  .pma-flow { margin-top: 14px; font-size: 13px; color: var(--text-2); display: flex; flex-direction: column; gap: 6px; }
  .pma-flow > div {
    display: flex; align-items: center; gap: 10px; padding: 8px 12px;
    background: var(--surface-2); border-radius: var(--radius-sm);
    border-left: 2px solid var(--border-light); opacity: 0.3; transition: all 0.4s var(--ease);
  }
  .step.active .pma-flow > div:nth-child(1) { animation: flowStep 0.4s 0.4s forwards; }
  .step.active .pma-flow > div:nth-child(2) { animation: flowStep 0.4s 1s forwards; }
  .step.active .pma-flow > div:nth-child(3) { animation: flowStep 0.4s 1.6s forwards; }
  .step.active .pma-flow > div:nth-child(4) { animation: flowStep 0.4s 2.2s forwards; }
  @keyframes flowStep { to { opacity: 1; border-left-color: var(--accent); background: var(--accent-soft); } }
  .pma-flow .step-num {
    width: 20px; height: 20px; background: var(--accent); color: white; border-radius: 50%;
    font-size: 11px; font-weight: 700; display: grid; place-items: center; flex-shrink: 0;
  }
  .pma-flow code { background: var(--surface-3); }

  /* ============ STEP 4: CREDENTIAL CARDS ============ */
  .creds { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  @media (max-width: 520px) { .creds { grid-template-columns: 1fr; } }
  .cred-card {
    background: var(--surface); border: 1px solid var(--border-light); border-radius: var(--radius);
    padding: 16px; position: relative; box-shadow: var(--shadow-sm);
    opacity: 0; transform: translateY(8px);
  }
  .step.active .cred-card { animation: cardIn 0.55s forwards; }
  .step.active .cred-card:nth-child(1) { animation-delay: 0.1s; }
  .step.active .cred-card:nth-child(2) { animation-delay: 0.25s; }
  .step.active .cred-card:nth-child(3) { animation-delay: 0.4s; }
  .step.active .cred-card:nth-child(4) { animation-delay: 0.55s; }
  @keyframes cardIn { to { opacity: 1; transform: translateY(0); } }
  .cred-card .cred-key {
    font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--accent);
    margin-bottom: 6px; font-weight: 600;
  }
  .cred-card .cred-label { font-size: 15px; font-weight: 600; color: var(--text); margin-bottom: 8px; }
  .cred-card .cred-val {
    font-family: 'JetBrains Mono', monospace; font-size: 13px; background: var(--code-bg);
    color: var(--str); padding: 5px 10px; border-radius: 6px; margin-bottom: 8px; display: inline-block;
  }
  .cred-card .cred-val.empty { color: var(--cmt); font-style: italic; }
  .cred-card .cred-desc { font-size: 13px; color: var(--text-2); line-height: 1.4; }
  .cred-card::before {
    content: attr(data-num); position: absolute; top: 14px; right: 16px;
    font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--border); font-weight: 700;
  }

  /* ============ STEP 5: BRIDGE ============ */
  .bridge { padding: 20px 6px; }
  .bridge-svg { width: 100%; height: auto; display: block; }
  .bridge .endpoint-circle { fill: var(--surface); stroke-width: 2.5; }
  .bridge .endpoint-circle.php { stroke: var(--accent); }
  .bridge .endpoint-circle.db { stroke: var(--db); }
  .bridge .endpoint-label { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 13px; font-weight: 500; fill: var(--text); text-anchor: middle; }
  .bridge .endpoint-tech { font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 600; text-anchor: middle; }
  .bridge .endpoint-tech.php { fill: var(--accent); }
  .bridge .endpoint-tech.db { fill: var(--db); }
  .bridge .span-line { stroke: var(--purple); stroke-width: 2.5; fill: none; stroke-dasharray: 240; stroke-dashoffset: 240; }
  .step.active .bridge .span-line { animation: drawLine 1.2s 0.3s forwards var(--ease); }
  @keyframes drawLine { to { stroke-dashoffset: 0; } }
  .bridge .conn-label { font-family: 'JetBrains Mono', monospace; font-size: 12px; font-weight: 600; fill: var(--accent); text-anchor: middle; opacity: 0; }
  .step.active .bridge .conn-label { animation: fadeUp 0.5s 1.4s forwards; }
  @keyframes fadeUp { from { opacity: 0; } to { opacity: 1; } }
  .bridge .pulse-dot { fill: var(--purple); opacity: 0; }
  .step.active .bridge .pulse-dot { animation: travelDot 2.5s 2s infinite var(--ease); }
  @keyframes travelDot {
    0% { opacity: 0; transform: translateX(0); }
    10% { opacity: 1; } 90% { opacity: 1; }
    100% { opacity: 0; transform: translateX(390px); }
  }

  /* ============ STEP 6: PATHS ============ */
  .paths { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .path { background: var(--surface); border: 1px solid var(--border-light); border-radius: var(--radius); padding: 16px; box-shadow: var(--shadow-sm); }
  .path-h {
    font-size: 14px; font-weight: 700; margin-bottom: 10px; padding-bottom: 8px;
    border-bottom: 1px solid var(--border-light); display: flex; align-items: center; gap: 8px;
  }
  .path.success .path-h { color: var(--success-deep); }
  .path.fail .path-h { color: var(--error); }
  .path-icon { width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; font-size: 12px; font-weight: 700; color: white; }
  .path.success .path-icon { background: var(--success); }
  .path.fail .path-icon { background: var(--error); }
  .path-conn { font-family: 'JetBrains Mono', monospace; font-size: 12px; margin-bottom: 8px; color: var(--text-2); }
  .path-conn .true { color: var(--success); font-weight: 600; }
  .path-conn .false { color: var(--error); font-weight: 600; }
  .path-out {
    background: var(--code-bg); padding: 10px 12px; border-radius: var(--radius-sm);
    font-family: 'JetBrains Mono', monospace; font-size: 12px; line-height: 1.5;
  }
  .path.success .path-out { color: var(--str); }
  .path.fail .path-out { color: #ff9b8a; }

  /* ============ STEP 7: HUB ============ */
  .hub-wrap { padding: 14px 0; }
  .hub-svg { width: 100%; height: auto; display: block; }
  .hub-line { stroke: var(--accent); stroke-width: 1.5; fill: none; opacity: 0.5; stroke-dasharray: 4 3; animation: dashFlow 30s linear infinite; }
  @keyframes dashFlow { to { stroke-dashoffset: -200; } }
  .hub-center-bg { fill: var(--accent); }
  .hub-center-text { font-family: 'JetBrains Mono', monospace; font-size: 11px; font-weight: 600; fill: white; text-anchor: middle; }
  .hub-leaf-bg { fill: var(--surface); stroke: var(--border); stroke-width: 1; }
  .hub-leaf-text { font-family: 'JetBrains Mono', monospace; font-size: 10px; fill: var(--text); text-anchor: middle; }
  .hub-arrow-label { font-family: 'Plus Jakarta Sans', sans-serif; font-size: 9px; fill: var(--text-3); text-anchor: middle; }

  /* ============ STEP 8: QUERY FLOW ============ */
  .qflow {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    background: var(--surface); border: 1px solid var(--border-light); border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-sm);
  }
  .qflow-side { padding: 22px 14px; text-align: center; }
  .qflow-side.php { background: var(--accent-soft); border-right: 1px dashed var(--border); }
  .qflow-side.db { background: var(--db-soft); border-left: 1px dashed var(--border); }
  .qflow-tag { font-family: 'JetBrains Mono', monospace; font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px; font-weight: 700; }
  .qflow-side.php .qflow-tag { color: var(--accent); }
  .qflow-side.db .qflow-tag { color: var(--db-deep); }
  .qflow-icon { font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 22px; margin-bottom: 4px; }
  .qflow-side.php .qflow-icon { color: var(--accent); }
  .qflow-side.db .qflow-icon { color: var(--db); }
  .qflow-sub { font-size: 12px; color: var(--text-2); font-family: 'JetBrains Mono', monospace; }
  .qflow-mid { padding: 16px 8px; position: relative; min-height: 110px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; }
  .qflow-arrow { position: relative; width: 110px; height: 18px; }
  .qflow-arrow.send::before { content: ''; position: absolute; top: 8px; left: 0; width: 100%; height: 2px; background: var(--accent); }
  .qflow-arrow.send::after { content: ''; position: absolute; right: -2px; top: 3px; border-left: 8px solid var(--accent); border-top: 6px solid transparent; border-bottom: 6px solid transparent; }
  .qflow-arrow.recv::before { content: ''; position: absolute; top: 8px; left: 0; width: 100%; height: 2px; background: var(--db); }
  .qflow-arrow.recv::after { content: ''; position: absolute; left: -2px; top: 3px; border-right: 8px solid var(--db); border-top: 6px solid transparent; border-bottom: 6px solid transparent; }
  .qflow-arrow-label {
    position: absolute; top: -14px; left: 50%; transform: translateX(-50%);
    font-family: 'JetBrains Mono', monospace; font-size: 11px; white-space: nowrap; font-weight: 600;
    background: var(--surface); padding: 0 6px;
  }
  .qflow-arrow.send .qflow-arrow-label { color: var(--accent); }
  .qflow-arrow.recv .qflow-arrow-label { color: var(--db); }
  .qflow-packet {
    background: var(--code-bg); color: var(--str); font-family: 'JetBrains Mono', monospace;
    font-size: 11px; padding: 4px 8px; border-radius: 6px; white-space: nowrap; opacity: 0; position: absolute;
  }
  .step.active .qflow-packet.q { animation: packetSend 3.8s 0.5s infinite var(--ease); }
  .step.active .qflow-packet.r { animation: packetRecv 3.8s 2.2s infinite var(--ease); }
  @keyframes packetSend {
    0% { opacity: 0; transform: translateX(-46px); } 15% { opacity: 1; transform: translateX(-46px); }
    50% { opacity: 1; transform: translateX(46px); } 60%, 100% { opacity: 0; transform: translateX(46px); }
  }
  @keyframes packetRecv {
    0% { opacity: 0; transform: translateX(46px); } 15% { opacity: 1; transform: translateX(46px); }
    50% { opacity: 1; transform: translateX(-46px); } 60%, 100% { opacity: 0; transform: translateX(-46px); }
  }

  /* ============ STEP 9: NUM ROWS ============ */
  .nrows { background: var(--surface); border: 1px solid var(--border-light); border-radius: var(--radius); padding: 18px; box-shadow: var(--shadow-sm); }
  .nrows-result { display: flex; gap: 6px; margin-bottom: 14px; }
  .nrows-row {
    flex: 1; background: var(--db-soft); border: 1px solid #b9d6df; border-radius: var(--radius-sm);
    padding: 8px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--db-deep); text-align: center; opacity: 0;
  }
  .step.active .nrows-row:nth-child(1) { animation: rowDrop 0.4s 0.3s forwards; }
  .step.active .nrows-row:nth-child(2) { animation: rowDrop 0.4s 0.5s forwards; }
  .step.active .nrows-row:nth-child(3) { animation: rowDrop 0.4s 0.7s forwards; }
  .step.active .nrows-row:nth-child(4) { animation: rowDrop 0.4s 0.9s forwards; }
  @keyframes rowDrop { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }
  .nrows-counter {
    display: flex; align-items: center; justify-content: space-between; padding: 12px 16px;
    background: var(--accent-soft); border: 1px solid #c9e2fa; border-radius: var(--radius-sm); font-size: 14px; margin-bottom: 14px;
  }
  .nrows-counter .label { font-family: 'JetBrains Mono', monospace; color: var(--accent); font-size: 13px; }
  .nrows-counter .value { font-size: 28px; font-weight: 800; color: var(--accent); opacity: 0; letter-spacing: -0.02em; }
  .step.active .nrows-counter .value { animation: countUp 0.5s 1.2s forwards var(--ease-spring); }
  @keyframes countUp { from { opacity: 0; transform: scale(0.6); } to { opacity: 1; transform: scale(1); } }
  .nrows-branch { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .nrows-branch > div { padding: 11px; border-radius: var(--radius-sm); font-family: 'JetBrains Mono', monospace; font-size: 12px; text-align: center; border: 1px solid; }
  .nrows-branch .yes { background: var(--success-soft); border-color: var(--success); color: var(--success-deep); font-weight: 600; opacity: 0; }
  .step.active .nrows-branch .yes { animation: branchIn 0.5s 1.5s forwards; }
  .nrows-branch .no { background: var(--surface-2); border-color: var(--border); color: var(--text-3); }
  @keyframes branchIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }

  /* ============ STEP 10: MORPH ============ */
  .morph { background: var(--surface); border: 1px solid var(--border-light); border-radius: var(--radius); padding: 18px; box-shadow: var(--shadow-sm); }
  .morph-h { font-size: 14px; color: var(--text-2); margin-bottom: 16px; text-align: center; }
  .morph-h code { background: var(--surface-2); padding: 2px 6px; border-radius: 5px; color: var(--accent); }
  .morph-grid { display: grid; grid-template-columns: 1fr auto 1fr; gap: 12px; align-items: center; }
  .morph-side h4 { font-family: 'JetBrains Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px; font-weight: 700; }
  .morph-side.mysql h4 { color: var(--db); }
  .morph-side.php h4 { color: var(--accent); }
  .sql-table { background: var(--surface); border: 1px solid var(--db-soft); border-radius: var(--radius-sm); overflow: hidden; font-family: 'JetBrains Mono', monospace; font-size: 12px; }
  .sql-row { display: grid; grid-template-columns: 28px 1fr 56px; padding: 6px 8px; border-bottom: 1px solid var(--db-soft); transition: all 0.3s var(--ease); }
  .sql-row.header { background: var(--db); color: white; font-weight: 700; font-size: 10px; text-transform: uppercase; }
  .sql-row.active { background: var(--accent-soft); transform: scale(1.03); box-shadow: 0 2px 10px -4px rgba(0,113,227,0.5); position: relative; z-index: 2; }
  .sql-row .col-id { color: var(--text-3); }
  .sql-row.active .col-id { color: var(--accent); font-weight: 600; }
  .sql-row .col-price { text-align: right; color: var(--success-deep); }
  .sql-row.active .col-price { color: var(--accent); }
  .morph-arrow { display: flex; flex-direction: column; align-items: center; gap: 4px; color: var(--accent); }
  .morph-arrow svg { width: 56px; height: 30px; }
  .morph-arrow-text { font-family: 'JetBrains Mono', monospace; font-size: 10px; color: var(--accent); text-align: center; line-height: 1.2; font-weight: 600; }
  .php-array { background: var(--code-bg); border-radius: var(--radius-sm); padding: 12px; font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--code-text); min-height: 112px; }
  .php-array .ar-line { display: block; padding: 1px 0; opacity: 0; transform: translateX(-4px); }
  .php-array .ar-line.show { opacity: 1; transform: translateX(0); transition: all 0.4s var(--ease); }
  .php-array .ar-k { color: var(--str); }
  .php-array .ar-arrow { color: var(--kw); }
  .php-array .ar-v { color: var(--num); }
  .php-array .ar-v.str { color: var(--str); }
  .php-array .ar-br { color: var(--var); }
  .morph-output { margin-top: 16px; padding-top: 14px; border-top: 1px dashed var(--border); }
  .morph-output-h { font-family: 'JetBrains Mono', monospace; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-2); margin-bottom: 8px; text-align: center; }
  .morph-output-ul { list-style: none; background: var(--surface-2); border-radius: var(--radius-sm); padding: 12px 16px; font-size: 14px; min-height: 60px; }
  .morph-output-ul li { padding: 4px 0 4px 18px; position: relative; opacity: 0; transform: translateY(-4px); transition: all 0.4s var(--ease); }
  .morph-output-ul li.show { opacity: 1; transform: translateY(0); }
  .morph-output-ul li::before { content: '▸'; position: absolute; left: 0; color: var(--accent); }
  .morph-output-ul li strong { font-weight: 600; color: var(--text); }
  .morph-output-ul li .price { color: var(--success-deep); font-family: 'JetBrains Mono', monospace; font-size: 13px; }
  .replay-btn {
    margin: 14px auto 0; display: block; background: var(--surface-2); border: 1px solid var(--border);
    font-family: inherit; font-size: 13px; font-weight: 600; padding: 7px 16px; border-radius: 100px;
    cursor: pointer; color: var(--text); transition: all 0.2s var(--ease);
  }
  .replay-btn:hover { background: var(--accent); border-color: var(--accent); color: white; }

  /* ============ NAV BAR ============ */
  .nav-bar {
    position: fixed; bottom: 0; left: 0; right: 0;
    background: rgba(251,251,253,0.85);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-top: 1px solid var(--border-light); z-index: 100;
  }
  .nav-inner {
    max-width: 1180px; margin: 0 auto; padding: 16px 32px;
    display: flex; justify-content: space-between; align-items: center; gap: 12px;
  }
  .step-counter { font-size: 13px; color: var(--text-2); font-weight: 500; font-variant-numeric: tabular-nums; }
  .step-counter strong { color: var(--text); font-weight: 700; }
  .btn {
    padding: 10px 22px; border-radius: 100px; border: none; font-family: inherit;
    font-weight: 600; font-size: 14px; cursor: pointer; transition: all 0.2s var(--ease);
    display: inline-flex; align-items: center; gap: 6px;
  }
  .btn-primary { background: var(--text); color: white; }
  .btn-primary:hover:not(:disabled) { background: #000; transform: scale(1.03); }
  .btn-primary:disabled { background: var(--surface-3); color: var(--text-3); cursor: not-allowed; }
  .btn-secondary { background: var(--surface-2); color: var(--text); }
  .btn-secondary:hover:not(:disabled) { background: var(--surface-3); }
  .btn-secondary:disabled { color: var(--text-3); cursor: not-allowed; opacity: 0.6; }

  @media (max-width: 720px) {
    main { padding: 32px 20px 150px; }
    h1 { font-size: 36px; }
    h2 { font-size: 27px; }
    .topbar-inner, .nav-inner { padding: 12px 20px; }
  }
</style>
</head>
<body>

<!-- ============ TOP BAR ============ -->
<div class="topbar">
  <div class="topbar-inner">
